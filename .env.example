# Runtime
BTQ_SOCIAL_DRY_RUN=true
BTQ_SOCIAL_CONTENT_DIR=./content/campaigns
BTQ_SOCIAL_INVITES_PATH=./data/invite-links.json
BTQ_SOCIAL_OUTBOX_PATH=./data/outbox.jsonl

# X (Twitter) — only needed when dry-run is false
# Create an app at https://developer.x.com with Read+Write
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Telegram broadcast (optional; not primary support — Discord is the hub)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default invite label when a post omits one (prefer requiring explicit labels)
BTQ_DEFAULT_INVITE_LABEL=x-bio

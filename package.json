{
  "name": "btq-social-funnel",
  "version": "0.1.0",
  "private": true,
  "description": "Schedule and publish BTQ social posts that always funnel into tracked Discord invites",
  "type": "module",
  "bin": {
    "btq-social": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "preview": "tsx src/cli.ts preview",
    "validate": "tsx src/cli.ts validate",
    "publish:dry": "tsx src/cli.ts publish --dry-run",
    "queue": "tsx src/cli.ts queue",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
